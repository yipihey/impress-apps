<!--
   The six generated app projects, in ONE workspace.

   This file was stale and unusable: it pointed at `apps/impel/project.yml`
   (a spec, not a project) and at `packages/ImpressModalEditing`, which no
   longer exists, and it omitted impart and impress. So nothing built through
   it, and every app was built as a standalone .xcodeproj into its own
   DerivedData - which meant PublicationManagerCore (602 files, 202,554 lines)
   plus ImpressChassis and ~25 packages were compiled once PER APP. After a
   single framework swap, the imprint and imbib app builds each logged 603
   "[PublicationManagerCore] Compiling" lines, and a six-app pass logged 3,516.

   In a workspace, SwiftPM resolves the package graph once and each local
   package is built once per (platform, configuration) for all six schemes.
   All six project.yml files already point at the same PublicationManagerCore
   path, so they share the package cleanly.

   The .xcodeproj files are gitignored and regenerated by xcodegen; this file
   is hand-kept and only references them.
-->
<Workspace
   version = "1.0">
   <FileRef location = "group:apps/imbib/imbib/imbib.xcodeproj"></FileRef>
   <FileRef location = "group:apps/imprint/imprint.xcodeproj"></FileRef>
   <FileRef location = "group:apps/implore/implore.xcodeproj"></FileRef>
   <FileRef location = "group:apps/impel/impel.xcodeproj"></FileRef>
   <FileRef location = "group:apps/impart/impart.xcodeproj"></FileRef>
   <FileRef location = "group:apps/impress/impress.xcodeproj"></FileRef>
</Workspace>
