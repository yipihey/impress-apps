{
  "package": "1.0",
  "name": "imbib",
  "version": "0.1.0",
  "description": "imbib's pages on koine's web frontend: the library, feeds, tags, a paper, online search and import, and citation resolution — every one a surface over imbib's verbs.",
  "surfaces": [
    {
      "name": "Library",
      "file": "surfaces/library.surface.json"
    },
    {
      "name": "Feeds",
      "file": "surfaces/feeds.surface.json"
    },
    {
      "name": "Tags",
      "file": "surfaces/tags.surface.json"
    },
    {
      "name": "Search online",
      "file": "surfaces/search.surface.json"
    },
    {
      "name": "Resolve a reference",
      "file": "surfaces/resolve.surface.json"
    }
  ],
  "skills": [
    {
      "name": "imbib",
      "file": "SKILL.md"
    }
  ],
  "requires": {
    "verbs": [
      "imbib-feeds-service_refresh-feed",
      "imbib-feeds-service_refresh-inbox-feeds",
      "imbib-library-service_set-read",
      "imbib-library-service_set-starred",
      "imbib-sources-service_source-status",
      "imbib-tags-service_add-tag",
      "imbib-tags-service_remove-tag",
      "imbib-view-service_feed-choices",
      "imbib-view-service_feed-rows",
      "imbib-view-service_import-ids",
      "imbib-view-service_library-choices",
      "imbib-view-service_paper-card",
      "imbib-view-service_paper-rows",
      "imbib-view-service_resolve-view",
      "imbib-view-service_search-rows",
      "imbib-view-service_tag-rows",
      "imbib-view-service_tag-tree"
    ],
    "secrets": []
  }
