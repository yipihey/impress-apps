{
  "package": "1.0",
  "name": "imbib",
  "version": "0.1.0",
  "description": "imbib's pages on koine's web frontend: the Inbox and its triage, the library, feeds, tags, collections, saved searches, a paper (flags, tags, collections), online search and import, and citation resolution — every one a surface over imbib's verbs.",
  "surfaces": [
    {
      "name": "Inbox",
      "file": "surfaces/inbox.surface.json"
    },
    {
      "name": "Library",
      "file": "surfaces/library.surface.json"
    },
    {
      "name": "Feeds",
      "file": "surfaces/feeds.surface.json"
    },
    {
      "name": "Tags",
      "file": "surfaces/tags.surface.json"
    },
    {
      "name": "Collections",
      "file": "surfaces/collections.surface.json"
    },
    {
      "name": "Smart searches",
      "file": "surfaces/smart-searches.surface.json"
    },
    {
      "name": "Search online",
      "file": "surfaces/search.surface.json"
    },
    {
      "name": "Resolve a reference",
      "file": "surfaces/resolve.surface.json"
    }
  ],
  "skills": [
    {
      "name": "imbib",
      "file": "SKILL.md"
    }
  ],
  "requires": {
    "verbs": [
      "collection-service_create",
      "collection-service_delete",
      "collection-service_rename",
      "imbib-feeds-service_refresh-feed",
