{
  "surface": "1.0",
  "name": "Resolve a reference",
  "state": {
    "reference": "",
    "scope": "",
    "selected": [],
    "imported": []
  },
  "sources": {
    "resolved": {
      "verb": "imbib-view-service_resolve-view",
      "args": { "reference": "{{state.reference}}" }
    },
    "choices": {
      "verb": "imbib-view-service_library-choices",
      "args": {}
    }
  },
  "root": {
    "column": [
      {
        "id": "intro",
        "text": "Paste a reference as it appears in a paper's bibliography — `Bromm V., Coppi P. S., Larson R. B., 2002, ApJ, 564, 23` — or a DOI, arXiv id, bibcode or BibTeX entry. imbib looks in your library first, then asks the online databases and scores each candidate. Nothing is imported until you choose."
      },
      {
        "id": "reference",
        "field": { "text": { "multiline": true, "rows": 3 } },
        "label": "Reference",
        "help": "Leave the field (or press Tab) to resolve.",
        "bind": "state.reference"
      },
      {
        "id": "verdict",
        "when": { "path": "state.reference" },
        "text": "{{source.resolved.verdict}}"
      },
      {
        "id": "candidates",
        "when": { "path": "source.resolved.rows.0" },
        "table": {
          "rows": "{{source.resolved.rows}}",
          "columns": ["Score", "Title", "Authors", "Year", "Venue", "Source"],
          "id_field": "id",
          "on_select": [
            { "set": { "path": "state.selected", "value": "{{event.value}}" } }
          ]
        }
      },
      {
        "id": "import-row",
        "when": { "path": "state.selected.0" },
        "grid": {
          "columns": 2,
          "items": [
            {
              "id": "scope",
              "field": { "select": { "options": "{{source.choices}}" } },
              "label": "Import into",
              "bind": "state.scope"
            },
            {
              "id": "import",
              "button": {
                "label": "Import the chosen paper",
                "on_click": [
                  {
                    "call": {
                      "verb": "imbib-view-service_import-ids",
                      "args": { "scope": "{{state.scope}}", "ids": "{{state.selected}}" },
                      "into": "state.imported"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "id": "imported",
        "when": { "path": "state.imported.0" },
        "table": {
          "rows": "{{state.imported}}",
          "columns": ["Identifier", "Outcome"]
        }
      }
    ]
  }
}
