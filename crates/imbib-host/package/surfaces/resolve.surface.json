{
  "surface": "1.0",
  "name": "Resolve a reference",
  "state": {
    "reference": "",
    "scope": "",
    "selected": [],
    "imported": []
  },
  "sources": {
    "resolved": {
      "verb": "imbib-sources-service_resolve-citation",
      "args": {
        "query": "{{state.reference}}",
        "download_pdfs": false,
        "preview": true
      }
    },
    "choices": {
      "verb": "imbib-view-service_library-choices",
      "args": {}
    }
  },
  "root": {
    "column": [
      {
        "id": "intro",
        "text": "Paste a reference as it appears in a paper's bibliography (or a DOI, arXiv id, bibcode or BibTeX entry). imbib looks in your library first, then asks the online databases, and scores each candidate: nothing is imported until you choose."
      },
      {
        "id": "reference",
        "field": { "text": { "multiline": true, "rows": 3 } },
        "label": "Reference",
        "help": "Press Enter, or leave the field, to resolve.",
        "bind": "state.reference"
      },
      {
        "id": "outcome",
        "when": { "path": "state.reference" },
        "kv": {
          "found via": "{{source.resolved.via}}",
          "reason": "{{source.resolved.reason}}"
        }
      },
      {
        "id": "local-paper",
        "when": { "path": "source.resolved.paper" },
        "section": {
          "title": "In your library",
          "collapsed": false,
          "body": { "id": "local-paper-kv", "kv": "{{source.resolved.paper}}" }
        }
      },
      {
        "id": "candidates",
        "when": { "path": "source.resolved.candidates.0" },
        "table": {
          "rows": "{{source.resolved.candidates}}",
          "columns": ["confidence", "title", "authors", "year", "venue", "sourceID"],
          "id_field": "identifier",
          "on_select": [
            { "set": { "path": "state.selected", "value": "{{event.value}}" } }
          ]
        }
      },
      {
        "id": "import-row",
        "when": { "path": "state.selected.0" },
        "grid": {
          "columns": 2,
          "items": [
            {
              "id": "scope",
              "field": { "select": { "options": "{{source.choices}}" } },
              "label": "Import into",
              "bind": "state.scope"
            },
            {
              "id": "import",
              "button": {
                "label": "Import the chosen paper",
                "on_click": [
                  {
                    "call": {
                      "verb": "imbib-view-service_import-ids",
                      "args": { "scope": "{{state.scope}}", "ids": "{{state.selected}}" },
                      "into": "state.imported"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "id": "imported",
        "when": { "path": "state.imported.0" },
        "table": {
          "rows": "{{state.imported}}",
          "columns": ["Identifier", "Outcome"]
        }
      }
    ]
  }
}
