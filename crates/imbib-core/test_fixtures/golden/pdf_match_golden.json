          "fields": {
            "title": "Gravitation und Elektrizitaet, Teil II",
            "author": "Weyl, Hermann",
            "year": "1918"
          }
        }
      ],
      "pdfs": [
        "/w/lib/Weyl_1918_Gravitation_und_Elektrizitaet.pdf"
      ],
      "expected": {
        "matches": [
