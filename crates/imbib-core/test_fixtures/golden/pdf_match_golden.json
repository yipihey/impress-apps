      "expected": {
        "matches": [
          {
            "pdf": "/w/lib/papers/interop.pdf",
            "citeKey": "jabref1",
            "signal": "declared-file-field",
            "verdict": "automatic",
            "confidence": 1.0
          }
        ],
        "unmatched": []
      }
    },
    {
      "name": "declared/beats-a-rival-cite-key",
      "why": "ADVERSARIAL. `einstein1905.pdf` IS the second entry's cite key (0.95), but the first entry DECLARES it (1.00). 1.00-0.95 is inside the ambiguity margin, so the margin alone would have offered both; the declaration rule is what makes this an answer instead of a question.",
      "entries": [
        {
          "id": "podolsky1935",
          "citeKey": "podolsky1935",
          "fields": {
            "title": "Can Quantum Mechanical Description Be Complete",
            "author": "Podolsky, Boris",
            "year": "1935"
          },
          "bdskFiles": [
            "einstein1905.pdf"
          ]
        },
        {
          "id": "einstein1905",
          "citeKey": "einstein1905",
          "fields": {
            "title": "Zur Elektrodynamik bewegter Koerper",
            "author": "Einstein, Albert",
            "year": "1905"
          }
        }
      ],
      "pdfs": [
        "/w/lib/einstein1905.pdf"
      ],
      "expected": {
        "matches": [
          {
            "pdf": "/w/lib/einstein1905.pdf",
            "citeKey": "podolsky1935",
            "signal": "declared-file-field",
            "verdict": "automatic",
            "confidence": 1.0
          }
        ],
        "unmatched": []
      }
    },
    {
      "name": "declared/two-entries-claim-one-file",
      "why": "ADVERSARIAL. Both entries declare the same PDF, so the declaration rule cannot break the tie and the margin fails. Genuinely ambiguous, so it is OFFERED — never silently attached to whichever sorted first.",
      "entries": [
        {
          "id": "alpha1999",
          "citeKey": "alpha1999",
          "fields": {
            "title": "Alpha",
            "author": "Alpha, A",
            "year": "1999"
          },
          "bdskFiles": [
            "shared.pdf"
          ]
        },
        {
          "id": "beta1999",
          "citeKey": "beta1999",
          "fields": {
            "title": "Beta",
            "author": "Beta, B",
            "year": "1999"
          },
          "bdskFiles": [
            "shared.pdf"
          ]
        }
      ],
      "pdfs": [
        "/w/lib/shared.pdf"
      ],
      "expected": {
        "matches": [
          {
            "pdf": "/w/lib/shared.pdf",
            "citeKey": "alpha1999",
            "signal": "declared-file-field",
            "verdict": "offer",
            "confidence": 1.0
          },
          {
            "pdf": "/w/lib/shared.pdf",
            "citeKey": "beta1999",
            "signal": "declared-file-field",
            "verdict": "offer",
            "confidence": 1.0
          }
        ],
        "unmatched": []
      }
    },
