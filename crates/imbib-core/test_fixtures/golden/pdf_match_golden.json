{
  "_about": [
    "ADR-0023 W5 golden corpus: PDFs discovered near a watched .bib, matched to",
    "that file's entries. One case = one folder's worth of entries and PDFs plus",
    "the EXACT verdicts the matcher must return.",
    "",
    "`bdskFiles` are relative paths the harness ENCODES with bdsk_file_encode",
    "into Bdsk-File-1..N, so the golden stays readable and the BibDesk codec is",
    "exercised on every run. `fields` are written verbatim.",
    "",
    "`confidence` is pinned to 1e-6. A change to the weights is therefore a",
    "change to this file, reviewed, rather than a number that drifted."
  ],
  "cases": [
    {
      "name": "declared/bdsk-file-exact-path",
      "why": "BibDesk's own data. The entry names the file; nothing inferred may outrank a statement of fact.",
      "entries": [
        {
          "id": "smith2024",
          "citeKey": "smith2024",
          "fields": {
            "title": "A Study of Nothing",
            "author": "Smith, John",
            "year": "2024"
          },
          "bdskFiles": [
            "Papers/whatever.pdf"
          ]
        }
      ],
      "pdfs": [
        "/w/lib/Papers/whatever.pdf"
      ],
      "expected": {
        "matches": [
          {
            "pdf": "/w/lib/Papers/whatever.pdf",
            "citeKey": "smith2024",
            "signal": "declared-file-field",
            "verdict": "automatic",
            "confidence": 1.0
          }
        ],
        "unmatched": []
      }
    },
    {
      "name": "declared/bdsk-file-name-moved",
      "why": "The user reorganised the folder. The entry still names THIS file by name; the location no longer resolves, so it scores below an exact path but still auto-attaches.",
      "entries": [
        {
          "id": "smith2024",
          "citeKey": "smith2024",
          "fields": {
            "title": "A Study of Nothing",
            "author": "Smith, John",
            "year": "2024"
          },
          "bdskFiles": [
            "Papers/whatever.pdf"
          ]
        }
      ],
      "pdfs": [
        "/w/lib/archive/2024/whatever.pdf"
      ],
      "expected": {
        "matches": [
          {
            "pdf": "/w/lib/archive/2024/whatever.pdf",
            "citeKey": "smith2024",
            "signal": "declared-file-field",
            "verdict": "automatic",
            "confidence": 0.97
          }
        ],
        "unmatched": []
      }
    },
    {
      "name": "declared/jabref-file-triple",
      "why": "JabRef writes `Description:path:PDF` into a plain `file` field. It is still the entry naming the file.",
      "entries": [
