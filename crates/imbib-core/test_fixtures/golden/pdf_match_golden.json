    {
      "name": "adversarial/same-author-same-year",
      "why": "ADVERSARIAL. Two 1905 Einstein papers and a PDF named for neither in particular. Both are FUZZY, so the ceiling alone already forbids attaching — this case pins that author+year with no title words still clears OFFER_CONFIDENCE, i.e. the user is asked rather than told nothing was found. The MARGIN is exercised by the case below it.",
      "entries": [
        {
          "id": "einstein1905a",
          "citeKey": "einstein1905a",
          "fields": {
            "title": "Zur Elektrodynamik bewegter Koerper",
            "author": "Einstein, Albert",
            "year": "1905"
          }
        },
        {
          "id": "einstein1905b",
          "citeKey": "einstein1905b",
          "fields": {
            "title": "Ueber einen die Erzeugung und Verwandlung des Lichtes",
            "author": "Einstein, Albert",
            "year": "1905"
          }
        }
      ],
      "pdfs": [
        "/w/lib/Einstein 1905.pdf"
      ],
      "expected": {
        "matchCount": 2,
        "allVerdicts": "offer",
        "allSignals": "fuzzy",
        "citeKeys": [
          "einstein1905b",
          "einstein1905a"
        ],
        "unmatched": []
      }
    },
    {
      "name": "adversarial/house-naming-collides-on-two-entries",
      "why": "ADVERSARIAL, and THE case AMBIGUITY_MARGIN exists for. Two papers by one author in one year whose first three title words are identical (a two-part paper) generate the SAME Author_Year_Title name, so both score 0.92 — above the auto threshold. Only the margin stops this from silently attaching to whichever sorted first, which would be a wrong answer written to the user's library with no question asked.",
      "entries": [
        {
          "id": "weyl1918a",
          "citeKey": "weyl1918a",
          "fields": {
            "title": "Gravitation und Elektrizitaet, Teil I",
