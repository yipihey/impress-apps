<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Grants impel-taskd access to the shared imbib/imprint workspace
        directory at ~/Library/Group Containers/QG3MEYVHMS.com.impress.suite/.
        (Team-ID prefix: authorized by the QG3MEYVHMS.* profile wildcard, so
        access never triggers the app-group TCC prompt.)

        The binary must be codesigned with an Apple Developer identity on
        team QG3MEYVHMS (the team that registered this group). For a fresh
        build, run `bash crates/impel-taskd/sign.sh`.

        Network entitlements (client + server) let the impel-taskd binary
        make outbound HTTP calls and listen on local ports — needed for
        anything that talks to scix / arXiv / etc., and for future HTTP
        transport.
    -->
    <key>com.apple.application-identifier</key>
    <string>QG3MEYVHMS.com.imbib.impart</string>
    <key>com.apple.developer.team-identifier</key>
    <string>QG3MEYVHMS</string>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>QG3MEYVHMS.com.impress.suite</string>
    </array>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
